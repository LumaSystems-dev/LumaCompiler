# Luma 0.1.1: input() читает строку из стандартного ввода.
# Результат — строка; EOF возвращает nil. Конверсия — явно: num(input()).
print("Как тебя зовут?")
let name = input()
print("Привет, " .. name .. "!")

print("Сколько тебе лет?")
let age = num(input())
print("Через год будет " .. (age + 1))
